<div id="page-content" style="min-height: 100vh;" class="container-fluid text-center align-items-start border-dark d-flex">
    <div class="container">
        <h1 class="p-3 display-5 my-5">Team Member Information</h1>
        <div class="card m-5">
            <div class="card-header">
                <h5 class="card-title"><%= pageData.member.name %></h5>
            </div>
            <div class="card-body">
                <img src="/img/<%= pageData.member.id %><%= pageData.member.type %>" class="img-fluid rounded-circle" style="max-width: 500px;" alt="Profile Picture">
                <p class="card-text">Role: <%= pageData.member.role %></p>
                <p class="card-text"><%= pageData.member.bio %></p>
            </div>
            <div class="card-footer">
                <a href="/about" class="btn btn-primary">Back</a>
            </div>
        </div>
    </div>
</div>